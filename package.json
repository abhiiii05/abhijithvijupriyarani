{
  "name": "abhijith-portfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Six independent portfolio directions for Abhijith Viju Priya Rani.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:1": "npm run dev -w @portfolio/01-index",
    "dev:2": "npm run dev -w @portfolio/02-console",
    "dev:3": "npm run dev -w @portfolio/03-blueprint",
    "dev:4": "npm run dev -w @portfolio/04-desktop",
    "dev:5": "npm run dev -w @portfolio/05-swiss",
    "dev:6": "npm run dev -w @portfolio/06-swissdesk",
    "build:all": "npm run typecheck -w @portfolio/content && npm run build --workspaces --if-present",
    "typecheck:all": "npm run typecheck --workspaces --if-present",
    "lint:all": "npm run lint --workspaces --if-present",
    "qa": "node scripts/qa.mjs"
  },
  "devDependencies": {
    "playwright": "1.64.1"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
